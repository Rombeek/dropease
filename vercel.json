{
  "version": 2,
  "framework": null,
  "installCommand": "npm install && npm install --prefix webapp",
  "buildCommand": "npm run build --prefix webapp",
  "outputDirectory": "webapp/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/webhook", "destination": "/api" }
  ]
}
