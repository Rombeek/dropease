# BotFather token
BOT_TOKEN=your_bot_token_here

# Public URL (HTTPS). On Vercel you can omit this — VERCEL_URL is used automatically.
WEBAPP_URL=https://your-project.vercel.app

# Webhook path (default: /webhook)
WEBHOOK_PATH=/webhook

# Server port
PORT=3000

# Local dev: receive bot updates via polling instead of webhook
USE_POLLING=false

# Local browser preview without Telegram initData (never enable in production)
DEV_BYPASS_AUTH=false

# Secret for webhook (optional; BotFather can set this when registering webhook)
WEBHOOK_SECRET=

# Shopify / WooCommerce (V1 stubs — fill when integrating)
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
WOOCOMMERCE_URL=
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=
